FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
solvers
{
    "p_rgh.*"
    {
        solver          GAMG;
        tolerance       1e-8;
        relTol          0.01;
        smoother        GaussSeidel;
    }
    "(U|h|k|epsilon).*"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
    }
}
SIMPLE
{
    momentumPredictor yes;
    nNonOrthogonalCorrectors 0;
    consistent      yes;
    residualControl
    {
        p_rgh           1e-4;
        U               1e-4;
        h               1e-4;
        "(k|epsilon)"   1e-4;
    }
}
relaxationFactors
{
    fields { p_rgh 0.7; }
    equations
    {
        U               0.3;
        h               0.3;
        "(k|epsilon)"   0.3;
    }
}
